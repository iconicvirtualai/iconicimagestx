{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/spa",
  "crons": [
    {
      "path": "/api/agents/run-reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/apprenticeship/release-holds",
      "schedule": "0 12 * * *"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "{dist/spa/index.html,public/studio/grass-reference.jpg}",
      "excludeFiles": "{node_modules/sharp/**,node_modules/@img/**,node_modules/.pnpm/sharp@*/**,node_modules/.pnpm/@img+sharp*/**}"
    },
    "api/media-display.mjs": {
      "maxDuration": 60,
      "includeFiles": "node_modules/.pnpm/@img+sharp-libvips-linux-x64@*/node_modules/@img/sharp-libvips-linux-x64/**",
      "excludeFiles": "{public/media/**,node_modules/.pnpm/@img+sharp-linuxmusl-x64@*/**,node_modules/.pnpm/@img+sharp-libvips-linuxmusl-x64@*/**}"
    }
  },
  "redirects": [
    {
      "source": "/pricing-v1",
      "destination": "/pricing",
      "statusCode": 301
    },
    {
      "source": "/pricing-v1/",
      "destination": "/pricing",
      "statusCode": 301
    },
    {
      "source": "/studio",
      "destination": "/studio-105",
      "permanent": false
    },
    {
      "source": "/studio/",
      "destination": "/studio-105",
      "permanent": false
    },
    {
      "source": "/gallery",
      "destination": "/portal",
      "permanent": false
    },
    {
      "source": "/gallery/",
      "destination": "/portal",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/media/display/p/(.*)",
      "destination": "/api/media-display"
    },
    {
      "source": "/api/media/display/o/(.*)",
      "destination": "/api/media-display"
    },
    {
      "source": "/api/media/display/(.*)",
      "destination": "/api/media-display"
    },
    {
      "source": "/api/site-content/media",
