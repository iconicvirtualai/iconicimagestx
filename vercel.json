{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/spa",
  "crons": [
    {
      "path": "/api/agents/run-reminders",
      "schedule": "0 14 * * *"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "{dist/spa/index.html,public/studio/grass-reference.jpg}"
    }
  },
  "redirects": [
    { "source": "/pricing-v1", "destination": "/pricing", "statusCode": 301 },
    { "source": "/pricing-v1/", "destination": "/pricing", "statusCode": 301 },
    { "source": "/studio", "destination": "/studio-105", "permanent": false },
    { "source": "/studio/", "destination": "/studio-105", "permanent": false },
    { "source": "/gallery", "destination": "/studio-105", "permanent": false },
    { "source": "/gallery/", "destination": "/studio-105", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/present/:token", "destination": "/api/presentations/shell/:token" },
    { "source": "/admin/owners", "destination": "/api/owners/page" },
    { "source": "/admin/owners/", "destination": "/api/owners/page" },
    { "source": "/owners", "destination": "/api/owners/page" },
    { "source": "/owners/", "destination": "/api/owners/page" },
    { "source": "/podcast-guest-prep", "destination": "/podcast-guest-prep.html" },
    { "source": "/podcast-guest-prep/", "destination": "/podcast-guest-prep.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
