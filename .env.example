# Names only. Put live values in Vercel, Firebase, or a local .env that is not committed.

APP_URL=
FRONTEND_URL=

# Local/dev admin bypass. Never set these on Vercel or in a production build.
ENABLE_TEMP_ADMIN=
VITE_ENABLE_TEMP_ADMIN=

# Required to run POST /api/staff/setup on a hosted deployment. One-time bootstrap.
STAFF_SETUP_SECRET=

FIREBASE_SERVICE_ACCOUNT=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Content library (/admin/content, /api/content-assets) uses the Firebase
# Storage bucket above and the Firestore collection contentAssets.
# No extra secrets. Cloudflare R2 is the long-term object store once a bucket
# exists; it is not wired. Neon is the future system of record for metadata.

# Square — Iconic client orders and invoices
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=

# Stripe — Studio Noir and legacy VSAI only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_MAPS_API_KEY=

MAILCHIMP_API_KEY=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=
CUBICASA_API_KEY=

AGENT_SERVICE_KEY=
CRON_SECRET=
