# Names only. Put live values in Vercel, Firebase, or a local .env that is not committed.

APP_URL=
FRONTEND_URL=
# Client-facing gallery, studio, invoice/pay, and portal links.
# Leave APP_URL as the Wix domain until the domain cutover.
# Unset uses https://iconicimagestx.vercel.app. Must be https. Trailing slashes are ignored.
PUBLIC_SITE_URL=
# Same origin for admin open-gallery and view-as-client links in the browser.
# Unset uses https://iconicimagestx.vercel.app.
VITE_PUBLIC_SITE_URL=
# Canonical and social origin for this app. Leave unset to use
# https://iconicimagestx.vercel.app. Set it when iconicimagestx.com serves this app.
VITE_SITE_ORIGIN=

# Local/dev admin bypass. Never set these on Vercel or in a production build.
ENABLE_TEMP_ADMIN=
VITE_ENABLE_TEMP_ADMIN=

# Optional path override for the coordinator scratch-pad lawn reference.
# Default is public/studio/grass-reference.jpg. The OpenAI key is the existing OPENAI_API_KEY.
STUDIO_GRASS_REFERENCE_PATH=

# Required to run POST /api/staff/setup on a hosted deployment. One-time bootstrap.
STAFF_SETUP_SECRET=

FIREBASE_SERVICE_ACCOUNT=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Square — Iconic client orders and invoices
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Optional. Verification also accepts the Vercel production host,
# https://iconicimagestx.vercel.app/api/payments/square-webhook,
# and the APP_URL / FRONTEND_URL webhook URLs (iconicimagestx.com).
SQUARE_WEBHOOK_NOTIFICATION_URL=

# Stripe — Studio Noir and legacy VSAI only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Non-order client email/SMS (portal password reset, contact auto-acks,
# the older /api/campaigns send, gallery and invoice mail, reminders).
# Default OFF. Leave unset on Vercel during RED.
# The GMass marketing portal does not read this flag. It uses MARKETING_SEND_LIVE.
# Set CLIENT_NOTIFY_LIVE=true only when Cadi exits RED.
# CLIENT_COMMS_ZONE=RED forces those sends off even if CLIENT_NOTIFY_LIVE=true.
# Does NOT affect order-received client confirmation: email template
# booking_received, or the bookingConfirmation SMS from POST /api/bookings.
# Those stay on. Do not set BOOKING_NOTIFY_LIVE.
# A separate public-booking password-setup email (account_password_setup)
# follows this gate and stays off until CLIENT_NOTIFY_LIVE=true and the zone
# is not RED. It is not an invoice or payment reminder.
CLIENT_NOTIFY_LIVE=
CLIENT_COMMS_ZONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# From-number for transactional SMS, including live-chat staff alerts.
# Live chat texts the Iconic Google Voice number +12813560965. It does not
# use a separate Twilio account or ADMIN_PHONE.
TWILIO_PHONE_NUMBER=
# Office inbox for the contact form and live chat. Defaults to
# photos@iconicimagestx.com when unset.
CONTACT_FORM_EMAIL=
# Internal new-order email. Staff only — never the client.
# Separate addresses, or a comma-separated list on either variable.
ADMIN_EMAIL=
COORDINATOR_EMAIL=

GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# Apprenticeship calendar. freeBusy and event writes use FIREBASE_SERVICE_ACCOUNT.
# Default is steven@iconicimagestx.com, Monday–Saturday, 9:00–18:00 America/Chicago.
# Share that calendar with the service account (Make changes to events), or set
# APPRENTICESHIP_CALENDAR_SUBJECT for domain-wide delegation.
APPRENTICESHIP_CALENDAR_ID=
APPRENTICESHIP_CALENDAR_SUBJECT=
APPRENTICESHIP_DAY_START=
APPRENTICESHIP_DAY_END=
APPRENTICESHIP_WORK_DAYS=
APPRENTICESHIP_HORIZON_DAYS=
APPRENTICESHIP_TIME_ZONE=
GOOGLE_MAPS_API_KEY=

# Public-site ads and analytics. Optional. Vite inlines these at build time.
# A blank value skips that tag. Google Ads conversions stay dormant until
# VITE_GOOGLE_ADS_ID and the matching label are both set.
VITE_GA4_MEASUREMENT_ID=
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_LABEL_BOOK_SUBMIT=
VITE_GOOGLE_ADS_LABEL_STUDIO_REQUEST=
VITE_GOOGLE_ADS_LABEL_CONTACT_SUBMIT=
VITE_GOOGLE_ADS_LABEL_CALL_CLICK=
VITE_GOOGLE_ADS_LABEL_RE75_BOOKING=
VITE_GOOGLE_ADS_LABEL_RE75_FORM_START=
VITE_UET_TAG_ID=
# Minutes of cushion when a calendar event has no location, or when
# GOOGLE_MAPS_API_KEY is missing. Booking still works without the key.
BOOKING_TRAVEL_BUFFER_MINUTES=30
# Suggested appointment pills on /book and staff scheduling.
# Unset follows Admin → Settings → Booking (default on).
# false forces the pills off without a deploy.
SUGGESTED_APPOINTMENTS_ENABLED=

MAILCHIMP_API_KEY=

# Email marketing through GMass. Server only — never a VITE_ variable, never committed.
# Create the key in the GMass dashboard: Settings → API Keys → Manage API Keys.
GMASS_API_KEY=
# Both must be exactly true before a campaign send or a test send.
# MARKETING_SEND_LIVE is the portal switch. It does not turn on booking,
# password-setup, gallery, order, invoice, Square receipt, or SMS sends.
MARKETING_SEND_LIVE=
# Must be exactly true before the server will create a GMass draft, send a campaign,
# or send a transactional test. Read-only GMass calls work with the key alone.
GMASS_SEND_ENABLED=
# Origin for unsubscribe links and other public links inside marketing email.
# Falls back to APP_URL. Leave APP_URL as the Wix domain.
MARKETING_PUBLIC_URL=
# Signs one-click unsubscribe links. Use a long random string.
MARKETING_UNSUBSCRIBE_SECRET=

# Communications assistants. Server only. Never a VITE_ variable and never sent to the browser.
# OpenAI chat uses OPENAI_API_KEY. Grok chat uses XAI_API_KEY at https://api.x.ai.
# A blank XAI_API_KEY shows "Add XAI_API_KEY to enable Grok" in the hub.
OPENAI_API_KEY=
XAI_API_KEY=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=
CUBICASA_API_KEY=

AGENT_SERVICE_KEY=
CRON_SECRET=

# Owners Suite — Cadi's scorecard. Server only. Never a VITE_ variable.
# If OWNER_EMAILS is unset or blank, nobody can open /admin/owners, including admins.
# Comma-separated. The intended login is Cadi's.
OWNER_EMAILS=cadi@iconicimagestx.com
# Signs the httpOnly session cookie. Optional when FIREBASE_SERVICE_ACCOUNT is set;
# that JSON is used as the signing secret if this is blank.
OWNER_SESSION_SECRET=
# Sheets reader. The suite uses FIREBASE_SERVICE_ACCOUNT when that JSON includes
# client_email and private_key. Otherwise it uses this pair. Share the scorecard
# with that service-account email as Viewer. Scope is spreadsheets.readonly.
OWNER_SHEETS_SA_EMAIL=
OWNER_SHEETS_SA_KEY=
# Local tests and screenshots only. Never set this on Vercel. Ignored when
# VERCEL or NODE_ENV=production is set. Serves invented preview numbers.
OWNER_SUITE_FIXTURES=

# Studio video editor. Leave blank until the owner approves the render worker.
# Unset means off in production and on in Vercel preview. Do not set the
# production values to true from this repo. See workers/video-render/README.md.
VIDEO_EDITOR_ENABLED=
VIDEO_TEMPLATES_ENABLED=
VITE_VIDEO_EDITOR_ENABLED=
VITE_VIDEO_TEMPLATES_ENABLED=
VIDEO_WORKER_URL=
VIDEO_WORKER_AUDIENCE=
VIDEO_WORKER_TOKEN=
VIDEO_TASKS_QUEUE=
VIDEO_TASKS_LOCATION=
VIDEO_TASKS_SERVICE_ACCOUNT=
VIDEO_API_BASE=
VIDEO_MUSIC_DIR=
VITE_DROPBOX_APP_KEY=
VITE_GOOGLE_PICKER_API_KEY=
VITE_GOOGLE_PICKER_CLIENT_ID=
