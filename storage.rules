rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // VSAI free-trial uploads — any authenticated user (including anonymous)
    // can upload their own files; only they can read them
    match /vsai-uploads/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Gallery media — only staff can write; clients can read their own delivered galleries
    match /galleries/{orderId}/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // Studio Uploads — RAW files and assets uploaded by photographers
    // TEMPORARY: allow public access for development until real auth is fully mapped
    match /Uploads/{allPaths=**} {
      allow read, write: if true;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
