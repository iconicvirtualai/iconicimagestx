rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isActiveStaff() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)).data.isActive != false
        && firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)).data.role in [
          'admin', 'coordinator', 'photographer', 'editor'
        ];
    }

    // VSAI free-trial uploads — any authenticated user (including anonymous)
    // can upload their own files; only they can read them
    match /vsai-uploads/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Gallery files are served to clients through signed URLs after the invoice is paid.
    match /galleries/{allPaths=**} {
      allow read, write: if isActiveStaff();
    }

    // Studio uploads stay on staff accounts. Public delivery uses signed URLs.
    match /Uploads/{allPaths=**} {
      allow read, write: if isActiveStaff();
    }

    // Content library. Public site delivery uses download-token URLs from the API.
    match /content-bucket/{allPaths=**} {
      allow read, write: if isActiveStaff();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
