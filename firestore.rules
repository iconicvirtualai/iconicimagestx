rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function staffData() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }

    function isStaff() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
        staffData().isActive != false &&
        staffData().role in ['admin', 'coordinator', 'photographer', 'editor'];
    }

    function isAdmin() {
      return isStaff() && staffData().role == 'admin';
    }

    function isCoordinator() {
      return isStaff() && staffData().role in ['admin', 'coordinator'];
    }

    function isPhotographer() {
      return isStaff() && staffData().role in ['admin', 'coordinator', 'photographer'];
    }

    function isEditor() {
      return isStaff() && staffData().role == 'editor';
    }

    function isClientOwner(clientId) {
      return isAuthenticated() && request.auth.uid == clientId;
    }

    function isOrderClient(orderId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/orders/$(orderId)).data.clientId == request.auth.uid;
    }

    // ─── Public Write Collections ────────────────────────────────────────────

    // Order requests: anyone can submit (booking form — no login required)
    match /orderRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isCoordinator();
    }

    // ─── Client Collections ──────────────────────────────────────────────────

    // Clients: staff can read/write, client can read their own record.
    // Owner check is first so a staff-rule error cannot deny clients/{uid}
    // during portal login. Other clients' documents stay staff-only.
    match /clients/{clientId} {
      allow read: if isClientOwner(clientId) || isStaff();
      allow create, update: if isCoordinator();
      allow delete: if isAdmin();
    }

    // ─── Staff Collections ───────────────────────────────────────────────────

    match /staff/{staffId} {
      // Own record is readable by that Auth user so login can tell a missing
      // or inactive staff doc from an active one. Everyone else's records
      // stay limited to active staff.
      allow read: if (isAuthenticated() && staffId == request.auth.uid) || isStaff();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Orders ──────────────────────────────────────────────────────────────

    match /orders/{orderId} {
      allow read: if isStaff() || isOrderClient(orderId);
      allow create, update: if isCoordinator();
      allow delete: if isAdmin();
    }

    // ─── Appointments ────────────────────────────────────────────────────────

    match /appointments/{appointmentId} {
      allow read: if isStaff() ||
        (isAuthenticated() &&
          get(/databases/$(database)/documents/appointments/$(appointmentId)).data.clientId == request.auth.uid);
      allow create, update: if isCoordinator();
      allow delete: if isAdmin();
    }

    // ─── Galleries ───────────────────────────────────────────────────────────

    match /galleries/{galleryId} {
      // Owning clients read a delivered gallery only after downloads are open.
      // downloadEnabled is set when the post-shoot invoice is paid or staff
      // releases the files. Booking does not require payment before the shoot.
      allow read: if isStaff() ||
        (isAuthenticated() &&
          resource.data.clientId == request.auth.uid &&
          resource.data.status in ['delivered', 'approved'] &&
          resource.data.downloadEnabled == true);
      allow create, update: if isPhotographer();
      allow delete: if isAdmin();
    }

    // ─── Invoices ────────────────────────────────────────────────────────────

    match /invoices/{invoiceId} {
      allow read: if isCoordinator() ||
        (isAuthenticated() &&
          get(/databases/$(database)/documents/invoices/$(invoiceId)).data.clientId == request.auth.uid);
      allow create, update: if isCoordinator();
      allow delete: if isAdmin();
    }

    // ─── Transactions ────────────────────────────────────────────────────────

    match /transactions/{transactionId} {
      allow read: if isCoordinator();
      allow create: if false; // server writes payments with the Admin SDK
      allow update: if isCoordinator();
      allow delete: if isAdmin();
    }

    // ─── Messages ────────────────────────────────────────────────────────────

    match /messages/{messageId} {
      // Client can read/write messages on their own orders
      allow read: if isStaff() ||
        (isAuthenticated() &&
          get(/databases/$(database)/documents/messages/$(messageId)).data.senderId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isStaff(); // mark as read
      allow delete: if isAdmin();
    }

    // ─── Edit Requests ───────────────────────────────────────────────────────

    match /editRequests/{requestId} {
      allow read: if isStaff() ||
        (isAuthenticated() &&
          get(/databases/$(database)/documents/editRequests/$(requestId)).data.clientId == request.auth.uid);
      allow create: if isAuthenticated(); // clients submit
      allow update: if isCoordinator();
      allow delete: if isAdmin();
    }

    // ─── Packages / Pricing ──────────────────────────────────────────────────

    // Booking catalog. Public read is what the booking form needs.
    // Active staff (admin, coordinator, photographer, editor) can maintain it.
    // Vercel does not deploy these rules — publish this file in the Firebase console.
    match /packages/{packageId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // Invoice presets (processing, fees, travel, tax, promotions).
    // Staff edit the list. Choosing one fills an invoice amount. It does not charge anyone.
    match /invoicePresets/{presetId} {
      allow read: if isStaff();
      allow create, update, delete: if isCoordinator();
    }

    // ─── Email Templates ─────────────────────────────────────────────────────

    match /emailTemplates/{templateId} {
      allow read: if isStaff();
      allow create, update: if isCoordinator();
      allow delete: if isAdmin();
    }

    // ─── Campaigns ───────────────────────────────────────────────────────────

    match /campaigns/{campaignId} {
      allow read, write: if isCoordinator();
      allow delete: if isAdmin();
    }

    // ─── AI Agent Logs ───────────────────────────────────────────────────────

    match /agentLogs/{logId} {
      allow read: if isStaff();
      allow create: if false; // server writes agent logs with the Admin SDK
      allow update: if isCoordinator(); // mark reviewed
      allow delete: if isAdmin();
    }

    // ─── Virtual Staging Jobs ────────────────────────────────────────────────

    match /vsaiJobs/{jobId} {
      allow read: if isStaff() ||
        (isAuthenticated() &&
          get(/databases/$(database)/documents/vsaiJobs/$(jobId)).data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated(); // polling updates
      allow delete: if isAdmin();
    }

    // ─── Site Settings ───────────────────────────────────────────────────────

    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Promo Codes ─────────────────────────────────────────────────────────

    match /promoCodes/{codeId} {
      allow read: if true; // booking form validates these
      allow write: if isAdmin();
    }

    // ─── Iconic Studio edit queue ────────────────────────────────────────────
    // Staff read/write for raw ingest, AI edits, and adjust saves.
    // A human must publish these rules in the Firebase console.
    // Vercel does not deploy firestore.rules.

    match /editJobs/{jobId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ─── Listings / projects ─────────────────────────────────────────────────
    // Admin Create Project and New Project write this collection from the
    // browser. Without this match the catch-all denies every staff write.

    match /listings/{listingId} {
      // Each or-branch is separate so a photographer query
      // (photographerIds array-contains uid) is provable. Coordinators and
      // editors can still read the whole collection.
      allow read: if isCoordinator() || isEditor()
        || (isAuthenticated() && resource.data.clientId == request.auth.uid)
        || (isPhotographer() && resource.data.photographerUid == request.auth.uid)
        || (isPhotographer() && resource.data.photographerIds is list
            && request.auth.uid in resource.data.photographerIds);
      allow create: if isCoordinator();
      allow update: if isCoordinator() || isEditor();
      allow delete: if isAdmin();
    }

    // ─── Catch-all: deny everything else ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
    // ─── SMS Logs ────────────────────────────────────────────────────────────

    // Inbound/outbound SMS records written by server via Twilio webhook
    match /smsLogs/{logId} {
      allow read: if isStaff();
      allow create: if false; // server-only via Admin SDK
      allow update: if isCoordinator();
      allow delete: if isAdmin();
    }

    // ─── Conversations (Twilio masked proxy) ─────────────────────────────────

    // Photographer <-> client masked SMS conversations
    match /conversations/{conversationId} {
      allow read: if isStaff();
      allow create: if false; // server-only via Admin SDK
      allow update: if isCoordinator(); // e.g. mark closed
      allow delete: if isAdmin();
    }


  }
}
